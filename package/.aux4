{
  "scope": "aux4",
  "name": "secret-aux4-cloud",
  "version": "0.0.2",
  "description": "aux4.cloud secret provider for aux4/secret, resolving secrets through the aux4.cloud control-plane API",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "secret",
    "provider",
    "cloud",
    "aux4-cloud"
  ],
  "dependencies": [
    "aux4/secret",
    "aux4/curl",
    "aux4/json"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "secret",
          "execute": [
            "profile:secret"
          ],
          "help": {
            "text": "Secret manager"
          }
        }
      ]
    },
    {
      "name": "secret",
      "commands": [
        {
          "name": "aux4-cloud",
          "execute": [
            "profile:secret:aux4-cloud"
          ],
          "help": {
            "text": "aux4.cloud secret provider"
          }
        }
      ]
    },
    {
      "name": "secret:aux4-cloud",
      "commands": [
        {
          "name": "get",
          "execute": [
            "set:token=!aux4 secret aux4-cloud resolve-token",
            "aux4 curl request --header \"Authorization: Bearer ${token}\" \"${base}/v1/${scope}/secrets/${ref}\" < /dev/null | aux4 json get '$.fields' | aux4 json select \"${fields}\""
          ],
          "help": {
            "text": "Get secret fields from aux4.cloud. AI agents: do not call this command directly, use secret:// URIs instead.",
            "variables": [
              {
                "name": "ref",
                "text": "The secret item name (e.g., customer_db)"
              },
              {
                "name": "fields",
                "text": "Comma-separated field names to retrieve (e.g., username,password)"
              },
              {
                "name": "otp",
                "text": "Include one-time password (not supported by this provider)",
                "default": "false"
              },
              {
                "name": "token",
                "text": "Bearer token; defaults to CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              },
              {
                "name": "base",
                "text": "aux4.cloud API base URL",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope",
                "env": "AUX4_CLOUD_SCOPE"
              }
            ]
          }
        },
        {
          "name": "set",
          "execute": [
            "set:token=!aux4 secret aux4-cloud resolve-token",
            "set:payload=object(value:${field})",
            "nout:aux4 curl request --method PUT --header \"Authorization: Bearer ${token}\" --header \"Content-Type: application/json\" --body value(payload) \"${base}/v1/${scope}/secrets/${ref}\" < /dev/null",
            "echo secret://aux4-cloud/${ref} updated"
          ],
          "help": {
            "text": "Update a secret field in aux4.cloud",
            "variables": [
              {
                "name": "ref",
                "text": "The secret item name (e.g., customer_db)"
              },
              {
                "name": "field",
                "text": "The field name to update"
              },
              {
                "name": "value",
                "text": "The new value",
                "hide": true
              },
              {
                "name": "token",
                "text": "Bearer token; defaults to CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              },
              {
                "name": "base",
                "text": "aux4.cloud API base URL",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope",
                "env": "AUX4_CLOUD_SCOPE"
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "set:token=!aux4 secret aux4-cloud resolve-token",
            "nout:aux4 curl request --method PUT --header \"Authorization: Bearer ${token}\" --header \"Content-Type: application/json\" --body value(fields) \"${base}/v1/${scope}/secrets/${item}\" < /dev/null",
            "echo secret://aux4-cloud/${item}"
          ],
          "help": {
            "text": "Create a new secret in aux4.cloud",
            "variables": [
              {
                "name": "item",
                "text": "The item name"
              },
              {
                "name": "fields",
                "text": "Field values as dot-notation flags (e.g., --fields.username john --fields.password s3cr3t)",
                "hide": true
              },
              {
                "name": "vault",
                "text": "The vault (ignored by this provider)",
                "default": ""
              },
              {
                "name": "category",
                "text": "The item category (ignored by this provider)",
                "default": "Login"
              },
              {
                "name": "token",
                "text": "Bearer token; defaults to CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              },
              {
                "name": "base",
                "text": "aux4.cloud API base URL",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope",
                "env": "AUX4_CLOUD_SCOPE"
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "set:token=!aux4 secret aux4-cloud resolve-token",
            "json:aux4 curl request --header \"Authorization: Bearer ${token}\" \"${base}/v1/${scope}/secrets\" < /dev/null | aux4 json get '$.secrets'",
            "each:aux4 secret aux4-cloud print-refs --name '${item.name}' --fields value(item.fields)"
          ],
          "help": {
            "text": "List secrets from aux4.cloud as secret:// references",
            "variables": [
              {
                "name": "token",
                "text": "Bearer token; defaults to CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              },
              {
                "name": "base",
                "text": "aux4.cloud API base URL",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope",
                "env": "AUX4_CLOUD_SCOPE"
              }
            ]
          }
        },
        {
          "name": "resolve-token",
          "private": true,
          "execute": [
            "when:${token}:echo \"${token}\"",
            "when:${token}:exit:0",
            "set:sso=!aux4 aux4 token 2>/dev/null",
            "when:${sso}==:exit:1:Not authenticated with aux4.cloud — run: aux4 aux4 login (or set CLOUD_SYNC_TOKEN)",
            "echo \"${sso}\""
          ],
          "help": {
            "text": "Internal: resolve the bearer token from CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
            "variables": [
              {
                "name": "token",
                "text": "The machine sync token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "print-refs",
          "private": true,
          "execute": [
            "json:printf '%s' value(fields)",
            "each:echo secret://aux4-cloud/${name}/${item}"
          ],
          "help": {
            "text": "Internal: print secret:// references for one item's field names",
            "variables": [
              {
                "name": "name",
                "text": "The secret item name"
              },
              {
                "name": "fields",
                "text": "JSON array of field names"
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "set:token=!aux4 secret aux4-cloud resolve-token",
            "nout:aux4 curl request --method DELETE --header \"Authorization: Bearer ${token}\" \"${base}/v1/${scope}/secrets/${ref}\" < /dev/null",
            "echo secret://aux4-cloud/${ref} removed"
          ],
          "help": {
            "text": "Remove a secret from aux4.cloud",
            "variables": [
              {
                "name": "ref",
                "text": "The secret item name (e.g., customer_db)"
              },
              {
                "name": "token",
                "text": "Bearer token; defaults to CLOUD_SYNC_TOKEN, falling back to the logged-in aux4 token",
                "env": "CLOUD_SYNC_TOKEN",
                "default": ""
              },
              {
                "name": "base",
                "text": "aux4.cloud API base URL",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "scope",
                "text": "aux4.cloud scope",
                "env": "AUX4_CLOUD_SCOPE"
              }
            ]
          }
        }
      ]
    }
  ]
}
